// Prisma schema - Sistema de Gestão para Loja de Veículos Seminovos
// Estoque de veículos, peças, vendas e financeiro (contas a pagar/receber)
// totalmente integrados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum StatusVeiculo {
  ESTOQUE
  RESERVADO
  VENDIDO
}

enum FormaPagamento {
  A_VISTA
  PARCELADO
  FINANCIADO
}

enum StatusConta {
  PENDENTE
  PAGO
  ATRASADO
}

enum StatusRecebimento {
  PENDENTE
  RECEBIDO
  ATRASADO
}

enum CategoriaPagar {
  COMPRA_VEICULO
  COMPRA_PECA
  DESPESA_OPERACIONAL
  COMISSAO
  SALARIO
  COMBUSTIVEL
  DEVOLUCAO_CLIENTE
  // Valor a devolver ao proprietário de um veículo consignado, apurado no
  // fechamento da venda ao comprador (a loja vendeu o carro de um terceiro).
  DEVOLUCAO_PROPRIETARIO
  OUTROS
}

enum CategoriaReceber {
  VENDA_VEICULO
  VENDA_PECA
  RETORNO_FINANCEIRA
  // Comissão sobre o seguro vendido junto com o financiamento. Precisa de
  // categoria própria: receita ligada a uma venda só entra na DRE quando a
  // categoria é consultada à parte (ver reports.ts) — com "OUTROS" o caixa
  // subiria sem o lucro subir, e o farol ficaria vermelho.
  COMISSAO_SEGURO
  OUTROS
}

enum StatusVenda {
  CONCLUIDA
  CANCELADA
}

// Tipo de operação: venda comum ou intermediação de financiamento de terceiros
// (o carro é de terceiro; a loja só viabiliza o financiamento e devolve o valor
// ao cliente, ficando com o lucro da intermediação).
enum TipoOperacao {
  VENDA
  FINANCIAMENTO_TERCEIROS
}

enum TipoRecorrencia {
  PAGAR
  RECEBER
}

enum CategoriaCustoVeiculo {
  PREPARACAO
  DOCUMENTACAO
  MECANICA
  FUNILARIA_PINTURA
  ESTETICA
  FRETE
  IPVA
  MULTA
  LICENCIAMENTO
  OUTROS
}

enum TipoCapital {
  APORTE
  RETIRADA
  PRO_LABORE
}

// Movimento de capital APLICADO numa conta Aplicação (investimento dos sócios).
enum TipoAplicacao {
  APLICAR       // sócio passa a ter capital aplicado na conta
  RESGATAR      // sócio tira capital aplicado (direto da própria Aplicação)
  RENDIMENTO    // juros creditados na conta, viram capital aplicado do sócio
  SUBSTITUICAO  // troca de dono da fatia aplicada (saque por outra conta)
}

enum UserRole {
  ADMIN
  OPERADOR
}

enum TipoConta {
  CAIXA
  BANCO
  POUPANCA
  FINANCEIRA
  OUTRO
}

enum StatusConsorcio {
  ATIVO
  CONTEMPLADO
  ENCERRADO
}

enum TipoAquisicao {
  A_VISTA
  PARCELADO
  FINANCIADO
  CONSORCIO
}

enum TipoCentroCusto {
  ESTRUTURAL
  OBRA
  IMOVEL
  OUTRO
}

enum StatusSolicitacao {
  PENDENTE
  APROVADA
  REJEITADA
  CONCLUIDA
  CANCELADA
}

// Conta financeira (caixa físico, banco...): todo pagamento e
// recebimento baixado passa por uma conta, que acumula saldo próprio.
model FinancialAccount {
  id             String            @id @default(cuid())
  name           String
  type           TipoConta         @default(CAIXA)
  bankName       String?
  agency         String?
  accountNumber  String?
  initialBalance Float             @default(0)
  isDefault      Boolean           @default(false)
  active         Boolean           @default(true)
  // % de imposto que a financeira retém sobre o retorno (só p/ tipo FINANCEIRA)
  returnTaxPercent Float           @default(0)
  // % do retorno LÍQUIDO que vai para o vendedor como comissão (facultativo).
  sellerReturnPercent Float        @default(0)
  // Conta de Aplicação (investimento dos sócios): o saldo é sempre distribuído
  // entre os beneficiários do capital via InvestmentAllocation.
  isInvestment   Boolean           @default(false)
  // Até quando a aplicação rende. Sem isto o dinheiro pode vencer e ficar
  // parado sem ninguém perceber. Nulo = aplicação sem prazo (liquidez diária).
  investmentMaturity DateTime?
  // Titular VERDADEIRO da conta: algumas contas cadastradas são de um sócio
  // (beneficiário do capital) e operam como se fossem da MVP. Nulo = conta da
  // própria empresa. Informativo — identifica o dono nas telas, sem alterar a
  // contabilidade/equação patrimonial.
  ownerBeneficiaryId String?
  ownerBeneficiary   CapitalBeneficiary? @relation("AccountOwner", fields: [ownerBeneficiaryId], references: [id])
  notes          String?
  payables       Payable[]
  receivables    Receivable[]
  transfersOut   AccountTransfer[] @relation("TransferFrom")
  transfersIn    AccountTransfer[] @relation("TransferTo")
  financedSales  Sale[]            @relation("SaleFinancer")
  allocations    InvestmentAllocation[]
  paymentCombos  PaymentCombo[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("financial_accounts")
}

// Transferência entre contas financeiras.
model AccountTransfer {
  id          String           @id @default(cuid())
  fromId      String
  from        FinancialAccount @relation("TransferFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          FinancialAccount @relation("TransferTo", fields: [toId], references: [id], onDelete: Cascade)
  amount      Float
  date        DateTime         @default(now())
  description String?
  createdAt   DateTime         @default(now())

  @@map("account_transfers")
}

// Consórcio: parcelas mensais geradas automaticamente em contas a pagar.
model Consortium {
  id                String          @id @default(cuid())
  name              String
  administrator     String?
  creditValue       Float
  installmentValue  Float
  installmentsCount Int
  dueDay            Int             @default(10)
  startDate         DateTime        @default(now())
  status            StatusConsorcio @default(ATIVO)
  contemplatedAt    DateTime?
  notes             String?
  payables          Payable[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("consortiums")
}

// Centro de custo (obra, imóvel, outro negócio): agrupa despesas e
// receitas para apurar o resultado de cada frente.
model CostCenter {
  id          String          @id @default(cuid())
  name        String
  type        TipoCentroCusto @default(OUTRO)
  // Centros estruturais (Capital, Veículos, Administrativo): criados pelo
  // sistema, identificados pela chave fixa e protegidos contra exclusão.
  key         String?         @unique
  structural  Boolean         @default(false)
  active      Boolean         @default(true)
  notes       String?
  payables    Payable[]
  receivables Receivable[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("cost_centers")
}

// Solicitação de compra: pedido -> aprovação do administrador ->
// conclusão (gera a conta a pagar com o valor final).
model PurchaseRequest {
  id              String            @id @default(cuid())
  number          Int               @unique @default(autoincrement())
  // Numeração por ano (0001/2026, reinicia em 0001 a cada ano).
  year            Int               @default(0)
  seq             Int               @default(0)
  description     String
  details         String?
  estimatedAmount Float?
  // Vencimento e número da NF/documento informados na solicitação; levados até
  // a conta a pagar quando a compra é aprovada/concluída.
  dueDate         DateTime?
  documentNumber  String?
  // Configuração de pagamento definida na criação (usada ao gerar o espelho em
  // Contas a pagar na aprovação): categoria e parcelamento.
  category           CategoriaPagar @default(OUTROS)
  // Rótulo de exibição da categoria (gerenciável). Nulo = usa o rótulo do enum.
  categoryLabel      String?
  installmentsCount  Int            @default(1)
  installmentPeriod  String?        // MENSAL | DIAS
  installmentDays    Int            @default(30)
  supplierId      String?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id])
  requestedBy     String
  // Fluxo estrutural indicado pelo solicitante (CAPITAL/VEICULOS/ADMINISTRATIVO)
  structuralKey   String?
  // Destino específico do lançamento conforme o fluxo: veículo (fluxo Veículos)
  // ou beneficiário do capital (fluxo Capital). Levados até a conta a pagar.
  vehicleId       String?
  vehicle         Vehicle?          @relation(fields: [vehicleId], references: [id])
  capitalBeneficiaryId String?
  capitalBeneficiary   CapitalBeneficiary? @relation(fields: [capitalBeneficiaryId], references: [id])
  status          StatusSolicitacao @default(PENDENTE)
  decidedBy       String?
  decidedAt       DateTime?
  decisionNotes   String?
  finalAmount     Float?
  payableId       String?
  // Espelho gerado em Contas a pagar (1 título ou N parcelas) ao aprovar.
  payables        Payable[]         @relation("PayablePurchaseRequest")
  attachments     PurchaseRequestAttachment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([year, seq])
  @@index([supplierId])
  @@map("purchase_requests")
}

// Arquivo anexado a uma solicitação de compra (foto, PDF, orçamento…).
// Guardado como bytes no próprio banco, igual aos demais anexos.
model PurchaseRequestAttachment {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  description       String
  filename          String
  mimeType          String
  size              Int
  data              Bytes
  createdAt         DateTime        @default(now())

  @@index([purchaseRequestId])
  @@map("purchase_request_attachments")
}

// Usuário do sistema (login por e-mail e senha).
// permissions: módulos liberados para operadores (admin sempre vê tudo).
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role             UserRole  @default(OPERADOR)
  permissions      String[]  @default([])
  // Dados do beneficiário para a Ordem de Pagamento (ex.: comissão de venda).
  document         String?
  phone            String?
  bankName         String?
  bankAgency       String?
  bankAccount      String?
  bankAccountType  String?
  pixKey           String?
  // Tipo da chave PIX: cpf | cnpj | telefone | email | aleatoria.
  pixKeyType       String?
  commissionPayables Payable[] @relation("PayableBeneficiary")
  sales            Sale[]    @relation("SaleSeller")
  preSales         PreSale[] @relation("PreSaleSeller")
  // Vínculo 1:1 com um beneficiário do capital (usuário que também é sócio).
  beneficiary      CapitalBeneficiary? @relation("BeneficiaryUser")
  // Combos de pagamento que este usuário montou (é o beneficiário do borderô).
  paymentCombos    PaymentCombo[] @relation("UserPaymentCombos")
  // Fornecedor-espelho (todo usuário também pode ser escolhido como fornecedor).
  supplier         Supplier? @relation("UserSupplier")
  // Perfil de acesso (modelo de permissões). Nulo = permissões manuais/admin.
  profileId        String?
  profile          Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  active           Boolean   @default(true)
  pending             Boolean   @default(false)
  resetRequestedAt    DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")
}

// Perfil de acesso personalizado (ex.: "Vendedor", "Financeiro"): um conjunto
// nomeado de permissões que pode ser aplicado a vários usuários.
model Profile {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[] @default([])
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  document  String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  // Dados bancários para pagamento (usados na Ordem de Pagamento).
  bankName        String?
  bankAgency      String?
  bankAccount     String?
  bankAccountType String?
  pixKey          String?
  // Quando preenchido, este fornecedor é o espelho de um usuário do sistema
  // (nome e dados bancários sincronizados a partir do usuário).
  userId    String?    @unique
  user      User?      @relation("UserSupplier", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  vehicles         Vehicle[]
  parts            Part[]
  payables         Payable[]
  recurring        RecurringEntry[]
  purchaseRequests PurchaseRequest[]

  @@map("suppliers")
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  document    String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sales       Sale[]
  partSales   PartSale[]
  receivables Receivable[]
  recurring   RecurringEntry[]

  @@map("customers")
}

model Vehicle {
  id               String        @id @default(cuid())
  orderNumber      Int           @unique @default(autoincrement())
  brand            String
  model            String
  version          String?
  manufactureYear  Int
  modelYear        Int
  // A placa/chassi só é única entre fichas ATIVAS (não vendidas): recomprar um
  // veículo já vendido cria uma nova ficha e o histórico antigo fica intacto.
  // Garantido no banco por índices parciais (ver migration allow_rebuy_plate).
  plate            String
  chassi           String?
  renavam          String?
  color            String?
  km               Int           @default(0)
  fuel             String?
  transmission     String?
  purchasePrice    Float
  salePrice        Float
  acquisitionType  TipoAquisicao @default(A_VISTA)
  downPayment      Float         @default(0)
  installmentsCount Int          @default(1)
  financerName     String?
  // Compra com repasse/troca: parte do valor negociado vai para quitar o
  // financiamento do antigo dono (banco) e para débitos do veículo; o líquido
  // é o que sobra para o vendedor. Credores separados nas contas a pagar.
  payoffAmount     Float         @default(0)
  payoffTo         String?
  debtsAmount      Float         @default(0)
  // Detalhamento opcional do total acima: [{ description, amount, dueDate }].
  // Vazio = um título só, como antes. Fica no veículo (e não só no formulário)
  // porque editar o veículo apaga e recria os títulos da compra.
  debtsItems       Json          @default("[]")
  // Quitação REAL (boleto do banco), quando diferente do acordado
  // (payoffAmount). O título sai pelo real e a diferença vira custo de ajuste
  // (acréscimo → custo; menor → reduz o custo) — o líquido ao vendedor não
  // muda. Nulo = boleto igual ao acordado.
  payoffActualAmount Float?
  // Em nome de quem o veículo está: o proprietário lido do último CRLV
  // anexado (preenchido pela leitura por IA; sobrescrito a cada leitura).
  docOwnerName     String?
  // Marcado MANUALMENTE como "em processo de transferência no DETRAN" — para
  // casos antigos em que a taxa foi paga fora do sistema e não há custo de
  // "transferência" para acender o selo sozinho. Anexar o CRLV novo encerra o
  // processo (o selo vira "Transferido"), independentemente desta marca.
  transferInProgress Boolean     @default(false)
  status           StatusVeiculo @default(ESTOQUE)
  // "Postado" na vitrine pública (opt-in manual, exige ao menos 1 foto).
  published        Boolean       @default(false)
  // Quando foi postado na vitrine (selo "Chegou agora" nos primeiros dias).
  publishedAt      DateTime?
  // Anúncio: destaque promocional (tanque cheio, transferência grátis, brinde…).
  adPromo          String?
  // Anúncio: campos OCULTOS (preco/ano/km/cor/combustivel/cambio/versao).
  // Vazio = mostra tudo (todos pré-selecionados).
  adHiddenFields   String[]      @default([])
  // Veículo de terceiro numa operação de financiamento de terceiros: NÃO é
  // patrimônio da loja — fica fora do estoque, da vitrine e dos relatórios.
  intermediation   Boolean       @default(false)
  // Veículo CONSIGNADO: pertence a um terceiro (o consignante = supplier), mas
  // fica no estoque/vitrine e é vendido como um veículo normal. purchasePrice
  // fica 0 (não é patrimônio comprado); a loja deve ao dono `ownerRefundAmount`
  // quando o carro é vendido (vira conta DEVOLUCAO_PROPRIETARIO ou aporte de
  // capital, apurado no fechamento da venda).
  consigned        Boolean       @default(false)
  ownerRefundAmount Float        @default(0)
  entryDate        DateTime      @default(now())
  photoUrl         String?
  notes            String?
  supplierId       String?
  supplier         Supplier?     @relation(fields: [supplierId], references: [id])
  payables         Payable[]
  receivables      Receivable[]
  costs            VehicleCost[]
  fuelEntries      FuelEntry[]
  attachments      VehicleAttachment[]
  sale             Sale?         @relation("SaleVehicle")
  tradeInForSale   Sale?         @relation("SaleTradeIn")
  purchaseRequests PurchaseRequest[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  cardItems        CardInvoiceItem[]

  @@index([supplierId])
  @@map("vehicles")
}

// Documento anexado a um veículo (ex.: "Comunicação de venda" do Detran). O
// arquivo é guardado no próprio banco (bytea), então funciona no Vercel/Neon
// sem storage externo. Também guarda a "Foto do cliente" (antifraude) com a
// geolocalização do momento da captura.
enum AttachmentKind {
  DOCUMENTO
  FOTO_CLIENTE
  FOTO_VEICULO
  CRLV
}

model VehicleAttachment {
  id          String         @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind        AttachmentKind @default(DOCUMENTO)
  description String
  filename    String
  mimeType    String
  size        Int
  data        Bytes
  // Geolocalização da foto do cliente (nula nos documentos comuns).
  latitude    Float?
  longitude   Float?
  geoAccuracy Float?
  // Endereço legível resolvido a partir das coordenadas (cidade, rua...).
  address     String?
  createdAt   DateTime       @default(now())

  @@index([vehicleId])
  @@map("vehicle_attachments")
}

// Documento da EMPRESA (ex.: contrato social, cartão CNPJ, alvará). Não tem
// vínculo com veículo — é da loja. O arquivo é guardado no próprio banco
// (bytea), como os anexos de veículo, para funcionar no Vercel/Neon sem
// storage externo.
model CompanyDocument {
  id          String   @id @default(cuid())
  description String
  filename    String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  @@map("company_documents")
}

// Custo lançado sobre um veículo específico (preparação, documentação,
// mecânica...). Sempre gera uma conta a pagar vinculada, mantendo o
// financeiro integrado; a soma entra no custo total e na margem real.
model VehicleCost {
  id          String                @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  description String
  category    CategoriaCustoVeiculo
  amount      Float
  date        DateTime              @default(now())
  // Custo lançado depois que o veículo já foi vendido (pós-venda): não entra na
  // margem da venda, aparece à parte no Lucro/Prejuízo e no prontuário.
  postSale    Boolean               @default(false)
  notes       String?
  payableId   String?               @unique
  payable     Payable?              @relation(fields: [payableId], references: [id], onDelete: SetNull)
  // Custo vindo de um lançamento da fatura do cartão (1:1) — apagar o item
  // apaga o custo junto.
  cardItemId  String?               @unique
  cardItem    CardInvoiceItem?      @relation(fields: [cardItemId], references: [id], onDelete: Cascade)
  // Lote da rotina de remuneração de capital sobre estoque (para estorno).
  stockInterestRunId String?
  createdAt   DateTime              @default(now())

  @@index([stockInterestRunId])
  @@map("vehicle_costs")
}

enum StatusPreVenda {
  ABERTA
  CONVERTIDA
  CANCELADA
}

// Pré-venda: rascunho da negociação para revisão/impressão. NÃO gera nenhum
// lançamento financeiro; só ao "Registrar venda" ela vira uma venda de fato.
model PreSale {
  id                String         @id @default(cuid())
  number            Int            @unique @default(autoincrement())
  saleType          TipoOperacao   @default(VENDA)
  vehicleId         String
  customerId        String
  saleDate          DateTime       @default(now())
  totalAmount       Float
  paymentMethod     FormaPagamento
  // Financiamento de terceiros: valor liberado pelo banco (F) e valor devolvido
  // ao cliente (D). O proprietário do documento (VENDEDOR do contrato) é um
  // terceiro cujos dados ficam nos campos owner*.
  financingAmount   Float          @default(0)
  refundAmount      Float          @default(0)
  // Refinanciamento: o proprietário refinancia o próprio veículo. A financeira
  // paga o valor financiado direto ao financiado; a loja recebe só o retorno.
  refinancing       Boolean        @default(false)
  ownerName         String?
  ownerDocument     String?
  ownerPhone        String?
  ownerAddress      String?
  // Dados bancários do comprador (para a transferência da devolução no contrato).
  buyerBankName        String?
  buyerBankAgency      String?
  buyerBankAccount     String?
  buyerBankAccountType String?
  buyerPixKey          String?
  // Parcelamento informado ao comprador (só informativo, consta no contrato).
  installmentsInfoCount  Int?
  installmentsInfoAmount Float?
  downPayment       Float          @default(0)
  installmentsCount Int            @default(0)
  financerAccountId String?
  financedAmount    Float?
  // Financeira/banco indicado pelo cliente, NÃO conveniado à loja (sem conta
  // financeira). Guarda o nome para o contrato; o repasse vira conta a receber
  // comum. Nulo quando a financeira é conveniada (usa financerAccountId).
  financerName      String?
  sellerName        String?
  sellerId          String?
  seller            User?          @relation("PreSaleSeller", fields: [sellerId], references: [id])
  notes             String?
  // Troca (veículo recebido do cliente) — dados brutos, o veículo só é criado
  // ao converter em venda.
  tradeIn           Boolean        @default(false)
  tiPlate           String?
  tiBrand           String?
  tiModel           String?
  tiVersion         String?
  tiManufactureYear Int?
  tiModelYear       Int?
  tiColor           String?
  tiKm              Int?
  tiFuel            String?
  tiTransmission    String?
  tiChassi          String?
  tiNegotiated      Float?
  tiPayoff          Float?
  tiPayoffTo        String?
  tiDebts           Float?
  /// Detalhamento dos débitos do veículo da troca (ver Vehicle.debtsItems).
  tiDebtsItems      Json           @default("[]")
  tiSupplierName    String?
  // Retorno da financeira (nível R-xx; 0 = sem retorno)
  returnLevel       Int            @default(0)
  // Comissão do vendedor (R$) — convertida em conta a pagar ao fechar a venda.
  commissionAmount  Float          @default(0)
  // Indicações de venda: [{ name, amount }] — cada uma vira conta a pagar
  // (categoria Comissão) ao converter a pré-venda.
  referrals         Json           @default("[]")
  // Transferência (DETRAN) cobrada: vira conta a pagar ao converter a venda.
  transferCharged   Boolean        @default(false)
  transferAmount    Float          @default(0)
  // Facultativo: pagar ao vendedor a comissão sobre o retorno da financeira.
  takeReturnCommission Boolean     @default(false)
  // Seguro vendido junto ao financiamento (comissão a receber, valor e data
  // desconhecidos até cair).
  insuranceSold     Boolean        @default(false)
  // Informativo: venda originada de anúncio de tráfego pago (card do dashboard).
  viaPaidTraffic    Boolean        @default(false)
  // Consignado: destino da devolução ao proprietário escolhido na negociação. O
  // valor em si é re-derivado do veículo na conversão em venda.
  ownerRefundToCapital     Boolean  @default(false)
  ownerRefundBeneficiaryId String?
  // Comissão do vendedor aplicada no capital dele (aporte) em vez de paga.
  commissionToCapital      Boolean  @default(false)
  // Venda paga com o CAPITAL de um sócio: no fechamento, o valor é recebido no
  // Banco Neutro e vira retirada do capital dele — independente de quem é o
  // cliente/nome no contrato.
  capitalPayerBeneficiaryId String?
  // Token público para a verificação da ficha via QR Code (página /verificar).
  publicToken       String         @unique @default(uuid())
  status            StatusPreVenda @default(ABERTA)
  convertedSaleId   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([customerId])
  @@map("pre_sales")
}

model Sale {
  id                String         @id @default(cuid())
  orderNumber       Int            @unique @default(autoincrement())
  saleType          TipoOperacao   @default(VENDA)
  // Financiamento de terceiros: valor liberado pelo banco (F), valor devolvido
  // ao cliente (D) e dados do proprietário do documento (VENDEDOR do contrato).
  financingAmount   Float          @default(0)
  refundAmount      Float          @default(0)
  // Refinanciamento: proprietário refinancia o próprio veículo (F vai direto ao
  // financiado; a loja recebe só o retorno).
  refinancing       Boolean        @default(false)
  ownerName         String?
  ownerDocument     String?
  ownerPhone        String?
  ownerAddress      String?
  // Dados bancários do comprador (para a transferência da devolução no contrato).
  buyerBankName        String?
  buyerBankAgency      String?
  buyerBankAccount     String?
  buyerBankAccountType String?
  buyerPixKey          String?
  // Parcelamento informado ao comprador (só informativo, consta no contrato).
  installmentsInfoCount  Int?
  installmentsInfoAmount Float?
  // Consignado: o veículo era de um terceiro. `ownerRefundAmount` (cópia travada
  // do veículo no fechamento) é o valor devido ao proprietário. Se
  // `ownerRefundToCapital`, esse valor vira aporte no capital do beneficiário
  // escolhido (sem sair do caixa); senão vira conta a pagar ao dono.
  consigned              Boolean   @default(false)
  ownerRefundAmount      Float     @default(0)
  ownerRefundToCapital   Boolean   @default(false)
  ownerRefundBeneficiaryId String?
  ownerRefundBeneficiary CapitalBeneficiary? @relation("SaleOwnerRefund", fields: [ownerRefundBeneficiaryId], references: [id])
  // Comissão do vendedor aplicada no capital dele (aporte) em vez de paga em
  // dinheiro — só quando o vendedor é beneficiário do capital.
  commissionToCapital    Boolean   @default(false)
  vehicleId         String         @unique
  vehicle           Vehicle        @relation("SaleVehicle", fields: [vehicleId], references: [id])
  tradeInVehicleId  String?        @unique
  tradeInVehicle    Vehicle?       @relation("SaleTradeIn", fields: [tradeInVehicleId], references: [id])
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])
  saleDate          DateTime       @default(now())
  totalAmount       Float
  downPayment        Float          @default(0)
  installmentsCount Int            @default(0)
  paymentMethod     FormaPagamento
  sellerName        String?
  sellerId          String?
  seller            User?          @relation("SaleSeller", fields: [sellerId], references: [id])
  // Financiamento: banco/financeira e valor financiado (repasse)
  financerName      String?
  financedAmount    Float?
  // Conta financeira da financeira (o valor financiado fica nela até a
  // financeira pagar/transferir para a conta da empresa)
  financerAccountId String?
  financerAccount   FinancialAccount? @relation("SaleFinancer", fields: [financerAccountId], references: [id])
  // Data em que a financeira pagou (repasse transferido para a conta da empresa)
  financerSettledAt DateTime?
  // Retorno da financeira: nível R-xx usado, valor líquido (após imposto) e a
  // data em que a financeira pagou o retorno (liquidado separado do repasse).
  returnLevel       Int            @default(0)
  returnNet         Float          @default(0)
  returnSettledAt   DateTime?
  // Valor realmente pago pela financeira (pode diferir do programado returnNet)
  returnPaidAmount  Float?
  // Comissão sobre o SEGURO vendido junto ao financiamento. Diferente do
  // retorno, não tem fórmula nem valor conhecido na venda: fica só marcada e
  // pendente (nada é lançado), e o valor entra quando o dinheiro cai.
  insuranceSold     Boolean        @default(false)
  insuranceAmount   Float?
  insuranceCommissionAmount Float  @default(0)
  insuranceSettledAt DateTime?
  // Comissão do vendedor (valor em R$, digitado na venda). Gera uma conta a
  // pagar (categoria Comissão, centro Administrativo) quando > 0.
  commissionAmount  Float          @default(0)
  // Indicações de venda: [{ name, amount }] — cada uma gera uma conta a pagar
  // (categoria Comissão, centro Administrativo), como a comissão do vendedor.
  referrals         Json           @default("[]")
  // Transferência (DETRAN) cobrada na venda: quando cobrada, vira uma conta a
  // pagar (custo, igual à comissão) e reduz o resultado daquela venda.
  transferCharged   Boolean        @default(false)
  transferAmount    Float          @default(0)
  // Quando a transferência de propriedade no DETRAN foi concluída. Nulo = o
  // carro ainda está no nome do dono anterior (multa e ponto continuam caindo
  // para ele). Não confundir com transferCharged, que é só a cobrança.
  transferDoneAt    DateTime?
  // Comissão do vendedor sobre o retorno da financeira (calculada no registro):
  // vira conta a pagar (Comissão) e reduz o resultado por competência.
  returnCommissionAmount Float     @default(0)
  // Informativo: venda originada de anúncio de tráfego pago (card do dashboard).
  viaPaidTraffic    Boolean        @default(false)
  notes             String?
  status            StatusVenda    @default(CONCLUIDA)
  receivables       Receivable[]
  payables          Payable[]
  // Aportes de capital gerados por esta venda (devolução do consignado aplicada
  // no capital de um beneficiário).
  capitalRefunds    CapitalTransaction[] @relation("SaleCapitalRefund")
  createdAt         DateTime       @default(now())

  @@index([customerId])
  @@map("sales")
}

model Part {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  quantity    Int        @default(0)
  minQuantity Int        @default(0)
  costPrice   Float
  salePrice   Float
  supplierId  String?
  supplier    Supplier?  @relation(fields: [supplierId], references: [id])
  payables    Payable[]
  partSales   PartSale[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([supplierId])
  @@map("parts")
}

model PartSale {
  id            String         @id @default(cuid())
  partId        String
  part          Part           @relation(fields: [partId], references: [id])
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  quantity      Int
  unitPrice     Float
  totalAmount   Float
  saleDate      DateTime       @default(now())
  paymentMethod FormaPagamento
  notes         String?
  receivables   Receivable[]
  createdAt     DateTime       @default(now())

  @@index([customerId])
  @@map("part_sales")
}

model Payable {
  id           String          @id @default(cuid())
  // Número sequencial da Ordem de Pagamento (igual Agrasty).
  orderNumber  Int             @unique @default(autoincrement())
  // Token público para verificação da Ordem de Pagamento via QR Code.
  publicToken  String          @unique @default(uuid())
  description  String
  category     CategoriaPagar
  // Categoria livre/personalizada informada pelo usuário (ex.: "Revisão").
  // Quando presente, prevalece sobre o rótulo do enum na exibição.
  categoryLabel String?
  // Nº do documento de origem (nota fiscal, fatura, boleto) informado no lançamento.
  documentNumber String?
  amount       Float
  dueDate      DateTime
  paymentDate  DateTime?
  status       StatusConta     @default(PENDENTE)
  supplierId   String?
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  vehicleId    String?
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id])
  partId       String?
  part         Part?           @relation(fields: [partId], references: [id])
  vehicleCost  VehicleCost?
  // Venda de origem (ex.: comissão do vendedor gerada por uma venda).
  saleId       String?
  sale         Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  // Beneficiário usuário (ex.: vendedor da comissão) — dados bancários na ordem.
  beneficiaryUserId String?
  beneficiaryUser   User?      @relation("PayableBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  recurringId  String?
  recurring    RecurringEntry? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  // Solicitação de compra que gerou este título (espelho da aprovação).
  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation("PayablePurchaseRequest", fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  // Anexos do título (ex.: nota fiscal, comprovante).
  attachments  PayableAttachment[]
  reconciledAt DateTime?
  bankRef      String?
  employeeId   String?
  consortiumId String?
  consortium   Consortium?     @relation(fields: [consortiumId], references: [id], onDelete: SetNull)
  costCenterId String?
  costCenter   CostCenter?     @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  // Sócio do capital (fluxo Capital): ao BAIXAR o título, gera a RETIRADA dele.
  capitalBeneficiaryId String?
  capitalBeneficiary   CapitalBeneficiary? @relation(fields: [capitalBeneficiaryId], references: [id], onDelete: SetNull)
  accountId    String?
  account      FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  // Combo de pagamentos: título jogado numa cesta para pagar em conjunto.
  paymentComboId String?
  paymentCombo   PaymentCombo?  @relation(fields: [paymentComboId], references: [id], onDelete: SetNull)
  notes        String?
  // Lançamento avulso feito direto no Livro caixa (não é um título do a-pagar).
  // Excluir um avulso no caixa apaga de vez; excluir um título estorna (volta PENDENTE).
  avulso       Boolean         @default(false)
  // Fatura de cartão de crédito: o título é uma linha só (total da fatura) e os
  // lançamentos individuais ficam em cardItems, cada um com seu fluxo.
  cardInvoice  Boolean         @default(false)
  cardItems    CardInvoiceItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([paymentComboId])
  // Índices de leitura: a lista/filtros de Contas a pagar, a DRE e as buscas por
  // origem varriam a tabela inteira sem eles.
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([status, paymentDate])
  @@index([accountId])
  @@index([supplierId])
  @@index([vehicleId])
  @@index([partId])
  @@index([saleId])
  @@index([beneficiaryUserId])
  @@index([capitalBeneficiaryId])
  @@index([recurringId])
  @@index([consortiumId])
  @@index([employeeId])
  @@index([purchaseRequestId])
  @@index([documentNumber])
  @@map("payables")
}

// Enum do ciclo de vida do combo de pagamentos.
enum ComboStatus {
  ABERTO
  SOLICITADO
  PAGO
  CANCELADO
}

// "Combo de pagamentos": cesta persistente de títulos a pagar que o usuário monta
// para quitar em conjunto. O beneficiário do borderô é o próprio usuário que o
// montou (recebe o total para pagar as contas). Ciclo: ABERTO → SOLICITADO → PAGO.
model PaymentCombo {
  id          String      @id @default(cuid())
  name        String
  status      ComboStatus @default(ABERTO)
  notes       String?
  // Beneficiário/dono: usuário logado que montou o combo (dados do borderô).
  userId      String?
  user        User?       @relation("UserPaymentCombos", fields: [userId], references: [id], onDelete: SetNull)
  requestedAt DateTime?
  paidAt      DateTime?
  // Quanto do total foi abatido no saldo devedor de capital do beneficiário
  // (vira aporte na baixa); o restante saiu em dinheiro. 0 = sem abatimento.
  capitalAbatement Float  @default(0)
  // Se true, paga o valor INTEGRAL ao beneficiário mesmo com saldo devedor
  // (não abate o capital). Default false = abate como de costume.
  payFull     Boolean     @default(false)
  // Forma de recebimento escolhida pelo solicitante: "conta" | "pix".
  payoutMethod String?
  // Conta que pagou o combo (na baixa).
  accountId   String?
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payables    Payable[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("payment_combos")
}

// Arquivo anexado a um título de contas a pagar (nota fiscal, comprovante…).
model PayableAttachment {
  id         String   @id @default(cuid())
  payableId  String
  payable    Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)
  description String
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([payableId])
  @@map("payable_attachments")
}

model Receivable {
  id                String            @id @default(cuid())
  description       String
  // Nº do documento de origem (nota fiscal, recibo) informado no lançamento.
  documentNumber    String?
  category          CategoriaReceber
  // Rótulo de exibição da categoria (gerenciável). Nulo = usa o rótulo do enum.
  categoryLabel     String?
  amount            Float
  dueDate           DateTime
  receivedDate      DateTime?
  status            StatusRecebimento @default(PENDENTE)
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id])
  saleId            String?
  sale              Sale?             @relation(fields: [saleId], references: [id])
  vehicleId         String?
  vehicle           Vehicle?          @relation(fields: [vehicleId], references: [id])
  partSaleId        String?
  partSale          PartSale?         @relation(fields: [partSaleId], references: [id])
  installmentNumber Int?
  totalInstallments Int?
  recurringId       String?
  recurring         RecurringEntry?   @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  reconciledAt      DateTime?
  bankRef           String?
  costCenterId      String?
  costCenter        CostCenter?       @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  // Sócio do capital (fluxo Capital): ao RECEBER o título, gera o APORTE dele.
  capitalBeneficiaryId String?
  capitalBeneficiary   CapitalBeneficiary? @relation(fields: [capitalBeneficiaryId], references: [id], onDelete: SetNull)
  accountId         String?
  account           FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  notes             String?
  // Lançamento avulso feito direto no Livro caixa (não é um título do a-receber).
  avulso            Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([customerId])
  @@map("receivables")
}

// Sessão de caixa: controle global de abertura/fechamento (estilo Agrasty). Um
// único estado para toda a loja — enquanto não há sessão aberta, os lançamentos
// ficam bloqueados. workDate é a "data de trabalho" do dia.
model CashboxSession {
  id        String    @id @default(cuid())
  workDate  DateTime
  openedAt  DateTime  @default(now())
  openedBy  String?
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())

  @@map("cashbox_sessions")
}

// Código de liberação do primeiro acesso: gerado pelo administrador e informado
// à pessoa; sem um código válido o "Cadastrar primeiro acesso" não prossegue.
// Uso único (usedByEmail/usedAt marcam o consumo).
model AccessCode {
  id          String    @id @default(cuid())
  code        String    @unique
  createdBy   String?
  usedByEmail String?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("access_codes")
}

// Preço por litro pré-determinado de cada combustível (tela Combustíveis):
// o operador digita o VALOR abastecido e o sistema calcula os litros.
model FuelPrice {
  id            String   @id @default(cuid())
  fuelType      String   @unique
  pricePerLiter Float
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("fuel_prices")
}

// Snapshot da posição patrimonial arquivado no FECHAMENTO do caixa, para o
// Boletim de Caixa (prova de auditoria). Cada fechamento insere uma nova linha
// (version = maior+1) preservando o rastro; o boletim lê a última versão da data.
model DashboardSnapshot {
  id            String   @id @default(cuid())
  referenceDate DateTime // dia de trabalho do caixa fechado
  data          Json     // PatrimonialStats + { equacao, lucroPrejuizo, check1Ok, check2Ok }
  version       Int      @default(1)
  archivedBy    String?
  archivedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([referenceDate])
  @@map("dashboard_snapshots")
}

// Tipo da categoria de lançamento: despesa (Contas a pagar/saída no caixa) ou
// receita (Contas a receber/recorrência a receber).
enum CategoriaKind {
  DESPESA
  RECEITA
}

// Categoria de lançamento gerenciável (Financeiro › Categorias). Serve de
// sugestão + rótulo (categoryLabel) nas telas. O enum de lógica é derivado de
// `code` (ex.: "COMISSAO", "VENDA_VEICULO"); `code` null = custom → OUTROS.
// `system` = categoria padrão protegida (não pode ser excluída).
model LaunchCategory {
  id        String        @id @default(cuid())
  name      String
  kind      CategoriaKind @default(DESPESA)
  system    Boolean       @default(false)
  code      String?
  createdAt DateTime      @default(now())

  @@unique([name, kind])
  @@map("launch_categories")
}

// Sócio/investidor da empresa: acompanha aportes, retiradas e pró-labore.
model CapitalBeneficiary {
  id           String               @id @default(cuid())
  name         String
  // Beneficiário que representa a própria empresa (criado pelos Parâmetros)
  isCompany    Boolean              @default(false)
  proLabore    Float                @default(0)
  // Entra na rotina do fechamento mensal (crédito do pró-labore).
  includeInMonthlyClosing Boolean   @default(false)
  active       Boolean              @default(true)
  notes        String?
  // Vínculo 1:1 com um usuário do sistema (o sócio que também tem login).
  userId       String?              @unique
  user         User?                @relation("BeneficiaryUser", fields: [userId], references: [id], onDelete: SetNull)
  // Agrupamento pai→filhos: um beneficiário "responsável" reúne outros
  // vinculados (ex.: cauções recebidas em nome dele). Só agrupa/visualiza —
  // não altera nenhum cálculo financeiro. Um nível apenas.
  parentId     String?
  parent       CapitalBeneficiary?  @relation("BeneficiaryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     CapitalBeneficiary[] @relation("BeneficiaryParent")
  transactions CapitalTransaction[]
  allocations  InvestmentAllocation[]
  purchaseRequests PurchaseRequest[]
  payables     Payable[]
  receivables  Receivable[]
  recurringEntries RecurringEntry[]
  // Vendas de consignados cuja devolução ao proprietário foi aplicada no capital
  // deste beneficiário (aporte).
  ownerRefundSales Sale[]           @relation("SaleOwnerRefund")
  // Contas financeiras cujo titular verdadeiro é este beneficiário (sócio).
  ownedAccounts    FinancialAccount[] @relation("AccountOwner")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  cardItems     CardInvoiceItem[]

  @@map("capital_beneficiaries")
}

// Razão do capital APLICADO: quanto de cada conta Aplicação pertence a cada
// beneficiário. O saldo aplicado do sócio na conta é a soma de `amount`
// (positivo credita, negativo debita). Para cada conta Aplicação, a soma de
// todas as alocações tem de bater com o saldo da conta (invariante).
model InvestmentAllocation {
  id            String             @id @default(cuid())
  accountId     String
  account       FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  beneficiaryId String
  beneficiary   CapitalBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  kind          TipoAplicacao
  amount        Float
  date          DateTime           @default(now())
  description   String?
  // Rastros dos lançamentos financeiros gerados (p/ estorno completo).
  transferId    String?
  receivableId  String?
  payableId     String?
  createdAt     DateTime           @default(now())

  @@index([accountId])
  @@index([beneficiaryId])
  @@map("investment_allocations")
}

// Movimentação de capital: aportes entram no caixa (conta a receber
// recebida) e retiradas/pró-labore saem (conta a pagar paga).
model CapitalTransaction {
  id            String             @id @default(cuid())
  beneficiaryId String
  beneficiary   CapitalBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  kind          TipoCapital
  amount        Float
  date          DateTime           @default(now())
  description   String?
  payableId     String?
  receivableId  String?
  // Aporte gerado por uma venda (devolução ao proprietário do consignado ou
  // comissão aplicada no capital): permite estornar ao cancelar a venda.
  saleId        String?
  sale          Sale?              @relation("SaleCapitalRefund", fields: [saleId], references: [id], onDelete: SetNull)
  // Gerada pelo fechamento mensal (zeragem do L/P e pró-labore): permite o
  // estorno completo ao reabrir o mês.
  monthlyClosingId String?
  monthlyClosing   MonthlyClosing? @relation(fields: [monthlyClosingId], references: [id], onDelete: SetNull)
  // Lote da rotina de remuneração de capital sobre estoque (para estorno).
  stockInterestRunId String?
  // Retirada gerada por um lançamento CAPITAL da fatura do cartão (1:1).
  cardItemId    String?            @unique
  cardItem      CardInvoiceItem?   @relation(fields: [cardItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())

  @@index([stockInterestRunId])
  // Toda baixa procura a movimentação pelo título/recebível vinculado.
  @@index([payableId])
  @@index([receivableId])
  @@map("capital_transactions")
}

// Lote de execução da rotina de remuneração de capital sobre o estoque: aplica
// uma taxa X% sobre o custo total de veículos em estoque, incorporando o juro ao
// custo de cada veículo e creditando o total como aporte de capital aos sócios
// (rateio por percentuais independentes). Cada execução é reversível (estorno).
model StockInterestRun {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  ratePercent   Float
  description   String?
  createdBy     String?
  totalInterest Float
  createdAt     DateTime @default(now())

  @@map("stock_interest_runs")
}

// Fechamento mensal (estilo Agrasty, SEM cobertura de saldo devedor dos sócios):
// zera o L/P do mês transferindo o resultado para o capital da empresa, credita
// o pró-labore dos beneficiários marcados e trava lançamentos no mês fechado.
model MonthlyClosing {
  id        String   @id @default(cuid())
  year      Int
  month     Int // 1-12
  result    Float // resultado (L/P) do mês transferido ao capital da empresa
  closedBy  String?
  closedAt  DateTime @default(now())
  snapshot  Json     @default("{}")
  transactions CapitalTransaction[]
  createdAt DateTime @default(now())

  @@unique([year, month])
  @@map("monthly_closings")
}

// Funcionário da loja (folha de pagamento simplificada).
model Employee {
  id            String    @id @default(cuid())
  name          String
  role          String?
  cpf           String?
  pixKey        String?
  salary        Float
  admissionDate DateTime  @default(now())
  dismissalDate DateTime?
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("employees")
}

// Abastecimento de combustível da frota (guincho, test-drive...).
model FuelEntry {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  vehicleId     String?
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  plate         String?
  driver        String?
  station       String?
  fuelType      String?
  liters        Float
  pricePerLiter Float
  total         Float
  km            Int?
  notes         String?
  payableId     String?
  createdAt     DateTime @default(now())

  @@map("fuel_entries")
}

// Lançamento recorrente: gera automaticamente uma conta a pagar ou a
// receber todo mês no dia configurado (aluguel, salários, assinaturas...).
model RecurringEntry {
  id              String            @id @default(cuid())
  kind            TipoRecorrencia
  description     String
  amount          Float
  dayOfMonth      Int
  // Fluxo estrutural (VEICULOS/ADMINISTRATIVO/CAPITAL) do título gerado; null =
  // ADMINISTRATIVO (comportamento antigo).
  structuralKey   String?
  // Quando > 0, a recorrência é "a cada N dias" (a partir de startDate). Quando
  // null, é mensal por dayOfMonth.
  intervalDays    Int?
  // Antecipa o vencimento para o último dia útil quando o dia cai em fim de
  // semana ou feriado nacional (padrão de guias de impostos: DAS/FGTS/DARF).
  anticipateToBusinessDay Boolean @default(false)
  // Fatura de cartão de crédito: o título gerado nasce com lançamentos
  // detalháveis (a recorrência só marca o dia do pagamento; o valor de cada
  // mês vira a soma dos lançamentos digitados na fatura).
  cardInvoice     Boolean @default(false)
  // Sócio do capital: quando o fluxo é CAPITAL, o título gerado carrega este
  // beneficiário e, ao ser baixado, lança o aporte/retirada dele.
  capitalBeneficiaryId String?
  capitalBeneficiary   CapitalBeneficiary? @relation(fields: [capitalBeneficiaryId], references: [id], onDelete: SetNull)
  categoryPagar   CategoriaPagar?
  categoryReceber CategoriaReceber?
  // Rótulo de exibição da categoria (gerenciável). Nulo = usa o rótulo do enum.
  categoryLabel   String?
  supplierId      String?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id])
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  active          Boolean           @default(true)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  notes           String?
  payables        Payable[]
  receivables     Receivable[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([supplierId])
  @@index([customerId])
  @@map("recurring_entries")
}

// Proteção contra força bruta nas portas públicas (login, código de
// liberação, esqueci a senha): uma linha por chave (e-mail ou IP) com a
// contagem de falhas na janela e o bloqueio temporário quando estoura.
model LoginThrottle {
  id          String    @id @default(cuid())
  key         String    @unique
  attempts    Int       @default(0)
  firstAt     DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("login_throttles")
}

// Parâmetros da empresa (linha única): dados usados nos documentos
// impressos (ordem de compra, contrato, venda) e na marca do sistema.
model CompanySettings {
  id                String   @id @default("company")
  razaoSocial       String   @default("MVP Veículos")
  nomeFantasia      String   @default("MVP Veículos")
  cnpj              String?
  inscricaoEstadual String?
  phone             String?
  email             String?
  address           String?
  city              String?
  uf                String?
  logoDataUrl       String?
  // Domínio oficial do site (ex.: https://mvpveiculos.com.br). Usado para montar
  // os links públicos: QR Codes (ficha/ordem), vitrine e sitemap do Google.
  publicUrl         String?
  // Instagram da loja (@usuario ou URL) — aparece no rodapé da vitrine pública.
  instagram         String?
  // Bloqueio do sistema (modo manutenção): só admins navegam; os demais veem o
  // aviso e as ações são recusadas até desbloquear.
  systemLocked      Boolean  @default(false)
  systemLockedBy    String?
  systemLockedAt    DateTime?
  // Parecer IA: configuração da inteligência artificial (provedor, chave, modelo).
  // A chave nunca é devolvida ao cliente; sem chave, o parecer fica indisponível.
  aiProvider        String?
  aiApiKey          String?
  aiModel           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("company_settings")
}

// Lançamento individual da fatura de cartão de crédito (dentro de um título
// cardInvoice). Cada item aponta um fluxo: ADMINISTRATIVO (despesa comum),
// VEICULOS (com carro → vira custo do veículo) ou CAPITAL (com sócio → vira
// retirada na baixa do título). O valor do título é a soma dos itens.
model CardInvoiceItem {
  id                   String              @id @default(cuid())
  payableId            String
  payable              Payable             @relation(fields: [payableId], references: [id], onDelete: Cascade)
  description          String
  amount               Float
  structuralKey        String              @default("ADMINISTRATIVO")
  vehicleId            String?
  vehicle              Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  capitalBeneficiaryId String?
  capitalBeneficiary   CapitalBeneficiary? @relation(fields: [capitalBeneficiaryId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  vehicleCost          VehicleCost?
  capitalTransaction   CapitalTransaction?

  @@index([payableId])
  @@map("card_invoice_items")
}
