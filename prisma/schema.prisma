// Prisma schema - Sistema de Gestão para Loja de Veículos Seminovos
// Estoque de veículos, peças, vendas e financeiro (contas a pagar/receber)
// totalmente integrados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum StatusVeiculo {
  ESTOQUE
  RESERVADO
  VENDIDO
}

enum FormaPagamento {
  A_VISTA
  PARCELADO
  FINANCIADO
}

enum StatusConta {
  PENDENTE
  PAGO
  ATRASADO
}

enum StatusRecebimento {
  PENDENTE
  RECEBIDO
  ATRASADO
}

enum CategoriaPagar {
  COMPRA_VEICULO
  COMPRA_PECA
  DESPESA_OPERACIONAL
  COMISSAO
  SALARIO
  COMBUSTIVEL
  OUTROS
}

enum CategoriaReceber {
  VENDA_VEICULO
  VENDA_PECA
  OUTROS
}

enum StatusVenda {
  CONCLUIDA
  CANCELADA
}

enum TipoRecorrencia {
  PAGAR
  RECEBER
}

enum CategoriaCustoVeiculo {
  PREPARACAO
  DOCUMENTACAO
  MECANICA
  FUNILARIA_PINTURA
  ESTETICA
  FRETE
  IPVA
  MULTA
  LICENCIAMENTO
  OUTROS
}

enum TipoCapital {
  APORTE
  RETIRADA
  PRO_LABORE
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  document  String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  vehicles  Vehicle[]
  parts     Part[]
  payables  Payable[]
  recurring RecurringEntry[]

  @@map("suppliers")
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  document    String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sales       Sale[]
  partSales   PartSale[]
  receivables Receivable[]
  recurring   RecurringEntry[]

  @@map("customers")
}

model Vehicle {
  id               String        @id @default(cuid())
  brand            String
  model            String
  version          String?
  manufactureYear  Int
  modelYear        Int
  plate            String        @unique
  chassi           String?       @unique
  color            String?
  km               Int           @default(0)
  fuel             String?
  transmission     String?
  purchasePrice    Float
  salePrice        Float
  status           StatusVeiculo @default(ESTOQUE)
  entryDate        DateTime      @default(now())
  photoUrl         String?
  notes            String?
  supplierId       String?
  supplier         Supplier?     @relation(fields: [supplierId], references: [id])
  payables         Payable[]
  costs            VehicleCost[]
  fuelEntries      FuelEntry[]
  sale             Sale?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("vehicles")
}

// Custo lançado sobre um veículo específico (preparação, documentação,
// mecânica...). Sempre gera uma conta a pagar vinculada, mantendo o
// financeiro integrado; a soma entra no custo total e na margem real.
model VehicleCost {
  id          String                @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  description String
  category    CategoriaCustoVeiculo
  amount      Float
  date        DateTime              @default(now())
  notes       String?
  payableId   String?               @unique
  payable     Payable?              @relation(fields: [payableId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())

  @@map("vehicle_costs")
}

model Sale {
  id                String         @id @default(cuid())
  vehicleId         String         @unique
  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id])
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])
  saleDate          DateTime       @default(now())
  totalAmount       Float
  downPayment        Float          @default(0)
  installmentsCount Int            @default(0)
  paymentMethod     FormaPagamento
  sellerName        String?
  notes             String?
  status            StatusVenda    @default(CONCLUIDA)
  receivables       Receivable[]
  createdAt         DateTime       @default(now())

  @@map("sales")
}

model Part {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  quantity    Int        @default(0)
  minQuantity Int        @default(0)
  costPrice   Float
  salePrice   Float
  supplierId  String?
  supplier    Supplier?  @relation(fields: [supplierId], references: [id])
  payables    Payable[]
  partSales   PartSale[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("parts")
}

model PartSale {
  id            String         @id @default(cuid())
  partId        String
  part          Part           @relation(fields: [partId], references: [id])
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  quantity      Int
  unitPrice     Float
  totalAmount   Float
  saleDate      DateTime       @default(now())
  paymentMethod FormaPagamento
  notes         String?
  receivables   Receivable[]
  createdAt     DateTime       @default(now())

  @@map("part_sales")
}

model Payable {
  id           String          @id @default(cuid())
  description  String
  category     CategoriaPagar
  amount       Float
  dueDate      DateTime
  paymentDate  DateTime?
  status       StatusConta     @default(PENDENTE)
  supplierId   String?
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  vehicleId    String?
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id])
  partId       String?
  part         Part?           @relation(fields: [partId], references: [id])
  vehicleCost  VehicleCost?
  recurringId  String?
  recurring    RecurringEntry? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  reconciledAt DateTime?
  bankRef      String?
  employeeId   String?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("payables")
}

model Receivable {
  id                String            @id @default(cuid())
  description       String
  category          CategoriaReceber
  amount            Float
  dueDate           DateTime
  receivedDate      DateTime?
  status            StatusRecebimento @default(PENDENTE)
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id])
  saleId            String?
  sale              Sale?             @relation(fields: [saleId], references: [id])
  partSaleId        String?
  partSale          PartSale?         @relation(fields: [partSaleId], references: [id])
  installmentNumber Int?
  totalInstallments Int?
  recurringId       String?
  recurring         RecurringEntry?   @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  reconciledAt      DateTime?
  bankRef           String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("receivables")
}

// Sócio/investidor da empresa: acompanha aportes, retiradas e pró-labore.
model CapitalBeneficiary {
  id           String               @id @default(cuid())
  name         String
  proLabore    Float                @default(0)
  active       Boolean              @default(true)
  notes        String?
  transactions CapitalTransaction[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("capital_beneficiaries")
}

// Movimentação de capital: aportes entram no caixa (conta a receber
// recebida) e retiradas/pró-labore saem (conta a pagar paga).
model CapitalTransaction {
  id            String             @id @default(cuid())
  beneficiaryId String
  beneficiary   CapitalBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  kind          TipoCapital
  amount        Float
  date          DateTime           @default(now())
  description   String?
  payableId     String?
  receivableId  String?
  createdAt     DateTime           @default(now())

  @@map("capital_transactions")
}

// Funcionário da loja (folha de pagamento simplificada).
model Employee {
  id            String    @id @default(cuid())
  name          String
  role          String?
  cpf           String?
  pixKey        String?
  salary        Float
  admissionDate DateTime  @default(now())
  dismissalDate DateTime?
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("employees")
}

// Abastecimento de combustível da frota (guincho, test-drive...).
model FuelEntry {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  vehicleId     String?
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  plate         String?
  driver        String?
  station       String?
  fuelType      String?
  liters        Float
  pricePerLiter Float
  total         Float
  km            Int?
  notes         String?
  payableId     String?
  createdAt     DateTime @default(now())

  @@map("fuel_entries")
}

// Lançamento recorrente: gera automaticamente uma conta a pagar ou a
// receber todo mês no dia configurado (aluguel, salários, assinaturas...).
model RecurringEntry {
  id              String            @id @default(cuid())
  kind            TipoRecorrencia
  description     String
  amount          Float
  dayOfMonth      Int
  categoryPagar   CategoriaPagar?
  categoryReceber CategoriaReceber?
  supplierId      String?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id])
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  active          Boolean           @default(true)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  notes           String?
  payables        Payable[]
  receivables     Receivable[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("recurring_entries")
}
