# URL do banco Postgres (Neon, Supabase, etc.)
# Na Vercel com a integração Neon, essas variáveis são criadas automaticamente.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# URL de conexão direta (sem pooler) — usada pelas migrações.
# Se seu provedor não tiver pooler, repita o mesmo valor de DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/banco?sslmode=require"
