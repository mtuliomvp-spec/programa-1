# URL do banco Postgres (Neon, Supabase, etc.)
# Na Vercel com a integração Neon, essas variáveis são criadas automaticamente.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# URL de conexão direta (sem pooler) — usada pelas migrações.
# Se seu provedor não tiver pooler, repita o mesmo valor de DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/banco?sslmode=require"

# Consulta de veículo pela placa (opcional).
# Contrate um token em um provedor de consulta veicular (ex.: wdapi2.com.br)
# e informe aqui. Sem o token, o botão "Buscar dados pela placa" explica
# como ativar em vez de buscar.
# PLACA_API_TOKEN="seu-token"
# URL alternativa do provedor, com os marcadores {placa} e {token}:
# PLACA_API_URL="https://wdapi2.com.br/consulta/{placa}/{token}"

# Segredo das sessões de login (opcional — sem ele, deriva do DATABASE_URL).
# Defina um valor aleatório longo em produção:
# AUTH_SECRET="troque-por-um-valor-aleatorio-longo"

# Envio de e-mails (redefinição de senha com link + aviso de aprovação).
# Recomendado: Brevo (brevo.com, grátis 300 e-mails/dia).
# BREVO_API_KEY="xkeysib-..."
# EMAIL_FROM="seu-email-verificado@gmail.com"
# Alternativa com domínio próprio: RESEND_API_KEY="re_..."
# URL pública do sistema (para os links dos e-mails; opcional na Vercel):
# APP_URL="https://seu-projeto.vercel.app"

# Consulta de débitos veiculares (adicional do plano wdapi2/API Placas).
# Usa o mesmo PLACA_API_TOKEN; opcionalmente outra URL com {placa} e {token}:
# PLACA_DEBITOS_URL="https://wdapi2.com.br/debitos/{placa}/{token}"

# Consulta de empresa pelo CNPJ (fornecedores/clientes) — gratuita, sem token.
# Padrão: BrasilAPI com ReceitaWS de reserva. Só defina para trocar o provedor:
# CNPJ_API_URL="https://brasilapi.com.br/api/cnpj/v1/{cnpj}"
# CNPJ_API_URL_FALLBACK="https://receitaws.com.br/v1/cnpj/{cnpj}"
